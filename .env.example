# Robinhood Chain testnet
# RPC_URL dipakai hanya oleh AEGIS_NETWORK=testnet; mode local selalu memakai Anvil lokal.
RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630
PK_DEPLOYER=0x...
PK_PROVIDER=0x...
PK_CLIENT_A=0x...
PK_CLIENT_B=0x...
# Alamat program Stylus AegisPoseidon (FR-25) di Robinhood Chain, dipakai DeployTestnet.s.sol. Dikomentari,
# BUKAN diisi kosong: `vm.envOr("POSEIDON_STYLUS", address(0))` gagal (bukan fallback dengan mulus) bila
# variabelnya ADA tapi nilainya kosong — hapus/isi "#" saat tidak dipakai, jangan biarkan "POSEIDON_STYLUS=" polos.
# POSEIDON_STYLUS=0x1027cf7DC26152012ed9Ef949Aa1432Bf1C7ef34

# Web console (web/): AEGIS_NETWORK=local memakai Anvil 8545 + kunci default; testnet memakai RPC_URL & PK_* di atas.
AEGIS_NETWORK=local
WEB_PORT=4040
# Blok deploy factory di testnet (fallback bila deployments/testnet-46630.json tidak punya "deployBlock"); 0 = scan dari genesis.
FACTORY_BLOCK=122028843
